{
  "about": "The cases of the rule that tells equal names in one Den folder apart. Each case lists a folder's entries in listing order; an entry is visible or hidden to the viewer, and its ordinal is the number it is shown with, or null. Only visible entries count, each group is numbered in listing order, and a hidden entry's ordinal is always null.",
  "cases": [
    {
      "description": "Names that all differ get no number.",
      "entries": [
        {
          "name": "Alpha",
          "visible": true,
          "ordinal": null
        },
        {
          "name": "Beta",
          "visible": true,
          "ordinal": null
        },
        {
          "name": "Gamma",
          "visible": true,
          "ordinal": null
        }
      ]
    },
    {
      "description": "A twin pair: the first is plain, the second gets 2.",
      "entries": [
        {
          "name": "Test 1",
          "visible": true,
          "ordinal": null
        },
        {
          "name": "Test 1",
          "visible": true,
          "ordinal": 2
        }
      ]
    },
    {
      "description": "Three of a kind: 2, then 3.",
      "entries": [
        {
          "name": "Test 1",
          "visible": true,
          "ordinal": null
        },
        {
          "name": "Test 1",
          "visible": true,
          "ordinal": 2
        },
        {
          "name": "Test 1",
          "visible": true,
          "ordinal": 3
        }
      ]
    },
    {
      "description": "A visible entry really named \"Test 1 (2)\" takes 2, so the twin gets 3.",
      "entries": [
        {
          "name": "Test 1",
          "visible": true,
          "ordinal": null
        },
        {
          "name": "Test 1",
          "visible": true,
          "ordinal": 3
        },
        {
          "name": "Test 1 (2)",
          "visible": true,
          "ordinal": null
        }
      ]
    },
    {
      "description": "A hidden entry named \"Test 1 (2)\" does not count: the twin still gets 2.",
      "entries": [
        {
          "name": "Test 1",
          "visible": true,
          "ordinal": null
        },
        {
          "name": "Test 1",
          "visible": true,
          "ordinal": 2
        },
        {
          "name": "Test 1 (2)",
          "visible": false,
          "ordinal": null
        }
      ]
    },
    {
      "description": "A hidden twin gives no number.",
      "entries": [
