#!/bin/sh
# zaf description: drop a slice's jj workspace: snapshot what is on disk, forget the workspace from the root, remove its directory (target/ included) and any empty parents; the bookmark stays; one already gone is quiet
# zaf 1: refused: the arguments are not <slice>, or the slice name leaves the workspaces directory
# zaf 2: a backend failed (jj is missing or refused, the snapshot failed, or the directory could not be removed)
# zaf mode: 750
# zaf group: team
slice=$1

if [ -z "$ZAF_ROOT" ] || [ "$#" -ne 1 ]; then
    echo "usage: workspace-drop <slice>, with ZAF_ROOT set" >&2
    exit 1
fi

# A slice name is a relative path of plain parts, below the workspaces directory, written in
# the characters `push` accepts.
case "/$slice/" in
    *//* | */./* | */../*)
        echo "slice name $slice is not a relative path inside the workspaces directory" >&2
        exit 1
        ;;
esac
case $slice in
    "" | /* | -* | *[!A-Za-z0-9._/+-]*)
        echo "slice name $slice is not a relative path inside the workspaces directory" >&2
        exit 1
        ;;
esac

workspaces=$ZAF_ROOT/.zaf/workspaces
dir=$workspaces/$slice

# `jj st` in the workspace snapshots what is on disk into its working-copy commit, so nothing
# left uncommitted is lost with the directory: commits live in the shared repository.
if [ -d "$dir/.jj" ]; then
    (cd "$dir" && jj --no-pager --color=never st) || exit 2
fi

# Forgetting a name jj does not hold is not an error, which is what makes a second drop quiet.
# The root's own working copy is someone else's checkout, so it is never snapshotted.
jj --no-pager --color=never --ignore-working-copy -R "$ZAF_ROOT" workspace forget "$slice" || exit 2

# The directory holds the workspace's own target/, which grows to tens of gigabytes.
if [ -e "$dir" ]; then
    rm -rf "$dir" || exit 2
fi

# A nested slice name leaves directories behind. `rmdir` refuses a non-empty one: another slice
# still lives there.
parent=$(dirname "$slice")
while [ "$parent" != "." ]; do
    rmdir "$workspaces/$parent" 2>/dev/null || break
    parent=$(dirname "$parent")
done
exit 0
