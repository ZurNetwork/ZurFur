#!/bin/sh
# zaf description: drop a slice's jj workspace: snapshot what is on disk, forget the workspace from the root when jj holds it at the slice's directory, remove that directory (target/ included) when it is a jj workspace, and any empty parents; the bookmark stays; one already gone is quiet
# zaf 1: refused: the arguments are not <slice>, the slice name leaves the workspaces directory or is not a task branch or is the base, jj holds the slice's workspace at another directory, another jj workspace is at the slice's directory, or the directory is not a jj workspace; nothing was dropped
# zaf 2: a backend failed (jj is missing or refused, the snapshot failed, or the directory could not be removed)
# zaf mode: 750
# zaf group: team
slice=$1

if [ -z "$ZAF_ROOT" ] || [ "$#" -ne 1 ]; then
    echo "usage: workspace-drop <slice>, with ZAF_ROOT set" >&2
    exit 1
fi

# A slice name is a relative path of plain parts, below the workspaces directory, written in
# the characters `push` accepts.
case "/$slice/" in
    *//* | */./* | */../*)
        echo "slice name $slice is not a relative path inside the workspaces directory" >&2
        exit 1
        ;;
esac
case $slice in
    "" | /* | -* | *[!A-Za-z0-9._/+-]*)
        echo "slice name $slice is not a relative path inside the workspaces directory" >&2
        exit 1
        ;;
esac
# A slice is a task branch as the manifest's task pattern writes it,
# feature/release-<version>-<epic>-<task> with bare numbers for the epic and the task, and never
# the base it merges into.
task_branch() {
    case $1 in
        feature/release-?*-?*-?*) ;;
        *) return 1 ;;
    esac
    branch_rest=${1#feature/release-}
    branch_task=${branch_rest##*-}
    branch_rest=${branch_rest%-*}
    branch_epic=${branch_rest##*-}
    branch_version=${branch_rest%-*}
    case $branch_task in "" | *[!0-9]*) return 1 ;; esac
    case $branch_epic in "" | *[!0-9]*) return 1 ;; esac
    case $branch_version in "" | *[!A-Za-z0-9.-]*) return 1 ;; esac
}
if ! task_branch "$slice"; then
    echo "slice name $slice is not a task branch, feature/release-<version>-<epic>-<task>" >&2
    exit 1
fi
if [ -n "$ZAF_BASE" ] && [ "$slice" = "$ZAF_BASE" ]; then
    echo "slice name $slice is the base, not a task branch" >&2
    exit 1
fi

workspaces=$ZAF_ROOT/.zaf/workspaces
dir=$workspaces/$slice

# Root commands never snapshot the root's own working copy: it is someone else's checkout.
root_jj() {
    jj --no-pager --color=never --ignore-working-copy -R "$ZAF_ROOT" "$@"
}

# The slice's directory as jj may record it, with the root's symbolic links resolved.
real_root=$(cd "$ZAF_ROOT" && pwd -P) || exit 2
real_dir=$real_root/.zaf/workspaces/$slice

# Every workspace jj holds, by name and directory: the directory it holds the slice's name at,
# and the name it holds the slice's directory under. Either is empty when jj holds none.
listing=$(root_jj workspace list -T 'name ++ "\t" ++ self.root() ++ "\n"') || exit 2
held=$(printf '%s\n' "$listing" | awk -F '\t' -v name="$slice" '$1 == name { print $2; exit }')
holder=$(printf '%s\n' "$listing" | awk -F '\t' -v a="$dir" -v b="$real_dir" '$2 == a || $2 == b { print $1; exit }')

# Only the slice's own workspace goes: one jj holds elsewhere under its name, another workspace
# at its directory, or a directory that is no jj workspace is left as it is.
if [ -n "$held" ] && [ "$held" != "$dir" ] && [ "$held" != "$real_dir" ]; then
    echo "jj holds workspace $slice at $held, not $dir; nothing was dropped" >&2
    exit 1
fi
if [ -n "$holder" ] && [ "$holder" != "$slice" ]; then
    echo "$dir is jj workspace $holder, not $slice; nothing was dropped" >&2
    exit 1
fi
if [ -e "$dir" ] && [ ! -d "$dir/.jj" ]; then
    echo "$dir is not a jj workspace; nothing was dropped" >&2
    exit 1
fi

# `jj st` in the workspace snapshots what is on disk into its working-copy commit, so nothing
# left uncommitted is lost with the directory: commits live in the shared repository.
if [ -n "$held" ] && [ -d "$dir/.jj" ]; then
    (cd "$dir" && jj --no-pager --color=never st) || exit 2
fi

# A name jj does not hold needs no forgetting, which is what makes a second drop quiet.
if [ -n "$held" ]; then
    root_jj workspace forget "$slice" || exit 2
fi

# The directory holds the workspace's own target/, which grows to tens of gigabytes. One left
# by an earlier drop that forgot the name and then stopped is the slice's too: no workspace
# holds it.
if [ -d "$dir/.jj" ]; then
    rm -rf "$dir" || exit 2
fi

# A nested slice name leaves directories behind. `rmdir` refuses a non-empty one: another slice
# still lives there.
parent=$(dirname "$slice")
while [ "$parent" != "." ]; do
    rmdir "$workspaces/$parent" 2>/dev/null || break
    parent=$(dirname "$parent")
done
exit 0
