{
	"name": "@zurfur/ui",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"sideEffects": [
		"**/*.css",
		"./src/lib/styles/index.ts"
	],
	"exports": {
		".": {
			"types": "./src/lib/index.ts",
			"svelte": "./src/lib/index.ts"
		},
		"./styles": {
			"types": "./src/lib/styles/index.ts",
			"svelte": "./src/lib/styles/index.ts"
		},
		"./tokens.json": "./src/lib/styles/tokens.json",
		"./tokens.additions.json": "./src/lib/styles/tokens.additions.json"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . --no-inline-config --max-warnings 0",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest --run",
		"tokens": "node src/checks/tokens/write.ts",
		"tokens:copy": "node src/checks/tokens/copy.ts"
	},
	"dependencies": {
		"@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
		"@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0"
	},
	"peerDependencies": {
		"svelte": "^5.56.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	}
}
